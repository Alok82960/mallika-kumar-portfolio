# .gitignore for full-stack portfolio

# Environment files
.env
.env.local
.env.*.local

# Node modules
node_modules/
package-lock.json
yarn.lock

# Build outputs
dist/
build/
.next/
out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Docker
docker-compose.override.yml
.dockerignore

# Database
*.sql
!database/migrations/*.js
!database/seeds/*.js

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp
